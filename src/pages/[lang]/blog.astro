---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import PageBlog from "../../components/PageBlog.astro";
import { getLangFromUrl } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const desc = lang === "es"
            ? "Artículos técnicos sobre DevOps, SRE, Kubernetes, Terraform, AWS, GCP, CI/CD y GitHub Actions: tutoriales y lecciones en producción."
            : "Technical articles on DevOps, SRE, Kubernetes, Terraform, AWS, GCP, CI/CD pipelines, and GitHub Actions.";
const titleSuffix = lang === "es"
            ? "Blog | Daryl Mendoza · DevOps / SRE"
            : "Blog | Daryl Mendoza · DevOps / SRE";
---

<Layout title={titleSuffix} description={desc}>
    <Navbar />
    <main style="padding-top: 100px;">
        <PageBlog />
    </main>
</Layout>
