---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getLangFromUrl } from "../../../i18n/utils";
import type { Lang } from "../../../lib/seo";
import { slugifyPostId } from "../../../lib/blog-ids";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    const langs = ["es", "en"] as const;
    const paths = [];
    for (const lang of langs) {
        for (const post of posts.filter((p) => p.data.lang === lang)) {
            paths.push({
                params: { lang, slug: slugifyPostId(post) },
                props: { post, slug: slugifyPostId(post) },
            });
        }
    }
    return paths;
}

interface Props {
    post: CollectionEntry<"blog">;
}

const { post } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url) as Lang;
const { Content } = await post.render();
---

<Layout
    title={`${post.data.title} | Daryl Mendoza`}
    description={post.data.description}
    type="article"
    publishedTime={post.data.pubDate.toISOString()}
    tags={post.data.tags}
>
    <Navbar />
    <main class="post-page container">
        <a href={`/${lang}/blog`} class="back-link">
            ← {lang === "es" ? "Volver al blog" : "Back to blog"}
        </a>
        <article class="post glass">
            <header>
                <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString(lang, {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                    })}
                </time>
                <h1>{post.data.title}</h1>
                {post.data.description && (
                    <p class="lead">{post.data.description}</p>
                )}
            </header>
            <div class="content">
                <Content />
            </div>
            {post.data.tags && post.data.tags.length > 0 && (
                <footer class="post-tags" aria-label={lang === "es" ? "Tags del artículo" : "Article tags"}>
                    {post.data.tags.map((tag) => (
                        <a href={`/${lang}/blog?tag=${encodeURIComponent(tag)}`} class="tag">
                            #{tag}
                        </a>
                    ))}
                </footer>
            )}
        </article>
    </main>
</Layout>

<style>
    .post-page {
        padding: 100px 2rem 4rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 500;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .post {
        padding: 3rem;
        border-radius: 1.5rem;
    }

    .post header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--glass-border);
    }

    .post time {
        font-size: 0.875rem;
        color: var(--text-secondary);
        font-family: var(--font-mono, monospace);
    }

    .post h1 {
        margin-top: 0.5rem;
        margin-bottom: 1rem;
        font-size: 2.5rem;
        line-height: 1.2;
    }

    .post .lead {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.6;
        margin: 0;
    }

    .content :global(h2) {
        margin-top: 2.5rem;
        font-size: 1.5rem;
        line-height: 1.3;
    }

    .content :global(h3) {
        margin-top: 2rem;
        font-size: 1.25rem;
    }

    .content :global(p) {
        line-height: 1.8;
        margin: 1rem 0;
    }

    .content :global(ul),
    .content :global(ol) {
        padding-left: 1.5rem;
        line-height: 1.8;
    }

    .content :global(code) {
        font-family: var(--font-mono, monospace);
        font-size: 0.9em;
        background: var(--glass-border);
        padding: 0.1rem 0.4rem;
        border-radius: 0.25rem;
    }

    .content :global(pre) {
        background: var(--glass-border);
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 1.5rem 0;
    }

    .content :global(pre code) {
        background: transparent;
        padding: 0;
    }

    .content :global(blockquote) {
        border-left: 3px solid var(--accent-primary);
        padding-left: 1rem;
        margin: 1.5rem 0;
        color: var(--text-secondary);
        font-style: italic;
    }

    .content :global(a) {
        color: var(--accent-primary);
    }

    .post-tags {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--glass-border);
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .post-tags .tag {
        padding: 0.35rem 0.85rem;
        background: var(--glass-border);
        border-radius: 99rem;
        font-size: 0.875rem;
        color: var(--accent-primary);
        text-decoration: none;
        transition: all 0.2s;
    }

    .post-tags .tag:hover {
        background: var(--accent-primary);
        color: var(--bg-primary);
    }

    @media (max-width: 640px) {
        .post {
            padding: 2rem 1.5rem;
        }
        .post h1 {
            font-size: 2rem;
        }
    }
</style>
