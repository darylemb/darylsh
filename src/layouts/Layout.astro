---
import "@fontsource-variable/roboto-mono";
import "../styles/theme.css";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
    title?: string;
    description?: string;
}

const lang = getLangFromUrl(Astro.url);
const {
    title = lang === "es"
        ? "Daryl | Portfolio Personal"
        : "Daryl | Personal Portfolio",
    description = lang === "es"
        ? "Ingeniero DevOps / SRE enfocado en automatización e infraestructura cloud."
        : "DevOps / SRE Engineer focused on automation and cloud infrastructure.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <link
            rel="canonical"
            href={new URL(
                Astro.url.pathname,
                Astro.site ?? "https://daryl.sh",
            ).toString()}
        />

        <!-- Anti-FOUC: apply theme before CSS parses to prevent flash.
             Reads localStorage, falls back to prefers-color-scheme. -->
        <script is:inline>
            (function () {
                try {
                    const stored = localStorage.getItem("darylsh:theme");
                    const theme =
                        stored === "light" || stored === "dark"
                            ? stored
                            : window.matchMedia &&
                                window.matchMedia(
                                    "(prefers-color-scheme: light)",
                                ).matches
                              ? "light"
                              : "dark";
                    document.documentElement.setAttribute("data-theme", theme);
                } catch {
                    document.documentElement.setAttribute("data-theme", "dark");
                }
            })();
        </script>

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="color-scheme" content="light dark" />
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
    }

    html,
    body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: "Roboto Mono Variable", monospace;
        height: 100%;
        width: 100%;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    h1,
    h2,
    h3,
    h4 {
        font-family: "Roboto Mono Variable", monospace;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    code,
    pre {
        background-color: var(--code-bg);
        border-radius: 0.25rem;
        padding: 0.1em 0.3em;
    }

    /* Micro-animations */
    .hover-lift {
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .hover-lift:hover {
        transform: translateY(-4px);
    }

    /* Utility: Glassmorphism */
    .glass {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
    }
</style>
