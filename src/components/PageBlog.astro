---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import {
    getAllPosts,
    getAllTagsForLang,
} from "../lib/blog";
import { slugifyPostId } from "../lib/blog-ids";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// server-side: just ship everything for the lang, with no filtering applied.
// Tag filtering happens client-side (see <script> below) because static
// sites can't re-render on query-string changes.
const posts = await getAllPosts(lang);
const allTags = await getAllTagsForLang(lang);
---

<section class="blog container" data-tags-section>
    <div class="header">
        <h1>{t("blog.title")}</h1>
        <p>{t("blog.description")}</p>
    </div>

    {
        allTags.length > 0 && (
            <nav
                class="tag-filter"
                aria-label={lang === "es" ? "Filtrar por tag" : "Filter by tag"}
            >
                <a
                    href={`/${lang}/blog`}
                    class="tag-pill active"
                    data-tag-all
                    aria-current="true"
                >
                    All
                </a>
                {allTags.map((tag) => (
                    <a
                        href={`/${lang}/blog?tag=${encodeURIComponent(tag)}`}
                        class="tag-pill outline"
                        data-tag={tag}
                    >
                        #{tag}
                    </a>
                ))}
                <a
                    href={`/${lang}/blog/tags`}
                    class="tag-pill outline all-tags-link"
                    title={lang === "es"
                        ? "Ver todos los tags"
                        : "View all tags"}
                >
                    {lang === "es" ? "Ver todos →" : "See all →"}
                </a>
            </nav>
        )
    }

    <div class="post-grid" data-post-grid>
        {
            posts.map((post) => (
                <article
                    class="post-card glass hover-lift"
                    data-post
                    data-tags={JSON.stringify(post.data.tags ?? [])}
                >
                    <span class="date">
                        {post.data.pubDate.toLocaleDateString(lang, {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <div class="tags">
                        {post.data.tags?.map((tag) => (
                            <a
                                href={`/${lang}/blog?tag=${encodeURIComponent(tag)}`}
                                class="tag"
                            >
                                #{tag}
                            </a>
                        ))}
                    </div>
                    <a
                        href={`/${lang}/blog/${slugifyPostId(post)}`}
                        class="read-more"
                    >
                        {lang === "es" ? "Leer más" : "Read more"} <span>→</span>
                    </a>
                </article>
            ))
        }
    </div>

    <div class="empty-state glass" data-empty-state hidden>
        <p>
            <span data-empty-message></span>
        </p>
        <a href={`/${lang}/blog`} class="clear-link" data-clear-link>
            {lang === "es" ? "Ver todos los posts" : "See all posts"}
        </a>
    </div>
</section>

<script is:inline>
    // Client-side tag filtering for static sites.
    // Reads ?tag=X from URL, hides posts whose data-tags array doesn't
    // include the active tag. Shows empty state if no posts match.
    (function () {
        const section = document.querySelector("[data-tags-section]");
        if (!section) return;

        // read lang from <html lang> attribute (set by Layout)
        const lang = (document.documentElement.lang || "es").toLowerCase().startsWith("en") ? "en" : "es";
        const grid = section.querySelector("[data-post-grid]");
        const empty = section.querySelector("[data-empty-state]");
        const emptyMsg = section.querySelector("[data-empty-message]");
        const allPill = section.querySelector("[data-tag-all]");
        const tagPills = section.querySelectorAll("a.tag-pill[data-tag]");

        function getTags(card) {
            try {
                const raw = card.getAttribute("data-tags") || "[]";
                return JSON.parse(raw);
            } catch {
                return [];
            }
        }

        function applyFilter(tag) {
            const cards = grid.querySelectorAll("[data-post]");
            let visibleCount = 0;

            cards.forEach((card) => {
                const postTags = getTags(card);
                const matches = !tag || postTags.includes(tag);
                card.hidden = !matches;
                if (matches) visibleCount++;
            });

            // Toggle active styling on pills
            tagPills.forEach((pill) => {
                const t = pill.getAttribute("data-tag");
                if (t === tag) {
                    pill.classList.remove("outline");
                    pill.classList.add("active");
                    pill.setAttribute("aria-current", "true");
                } else {
                    pill.classList.remove("active");
                    pill.classList.add("outline");
                    pill.removeAttribute("aria-current");
                }
            });

            if (allPill) {
                if (!tag) {
                    allPill.classList.remove("outline");
                    allPill.classList.add("active");
                    allPill.setAttribute("aria-current", "true");
                } else {
                    allPill.classList.remove("active");
                    allPill.classList.add("outline");
                    allPill.removeAttribute("aria-current");
                }
            }

            // Update URL without reloading the page (so back/forward work).
            const url = new URL(window.location.href);
            if (tag) {
                url.searchParams.set("tag", tag);
            } else {
                url.searchParams.delete("tag");
            }
            window.history.replaceState({}, "", url);

            // Empty state
            if (visibleCount === 0) {
                empty.hidden = false;
                const msg = tag
                    ? (lang === "es"
                        ? "No hay posts con el tag \"" + tag + "\"."
                        : "No posts with the tag \"" + tag + "\".")
                    : (lang === "es"
                        ? "No hay posts."
                        : "No posts.");
                emptyMsg.textContent = msg;
                grid.hidden = true;
            } else {
                empty.hidden = true;
                grid.hidden = false;
            }
        }

        // Read initial ?tag from URL
        const params = new URLSearchParams(window.location.search);
        const initialTag = params.get("tag");
        if (initialTag) {
            applyFilter(initialTag);
        }

        // Wire up pill clicks
        tagPills.forEach((pill) => {
            pill.addEventListener("click", function (e) {
                e.preventDefault();
                const tag = pill.getAttribute("data-tag");
                applyFilter(tag);
                // Scroll to top of section after filter
                section.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        });

        if (allPill) {
            allPill.addEventListener("click", function (e) {
                e.preventDefault();
                applyFilter(null);
                section.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        }

        // Listen for back/forward navigation
        window.addEventListener("popstate", function () {
            const params = new URLSearchParams(window.location.search);
            const t = params.get("tag");
            applyFilter(t);
        });
    })();
</script>

<style>
    .blog {
        padding: 80px 2rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .header {
        margin-bottom: 2.5rem;
    }

    h1 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .header p {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    /* Tag pill filter */
    .tag-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 3rem;
        padding: 1rem 0;
        border-top: 1px solid var(--glass-border);
        border-bottom: 1px solid var(--glass-border);
    }

    .tag-pill {
        padding: 0.4rem 1rem;
        border-radius: 99rem;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.2s;
        white-space: nowrap;
        cursor: pointer;
    }

    .tag-pill.active {
        background: var(--accent-primary);
        color: var(--bg-primary);
        border: 1px solid var(--accent-primary);
    }

    .tag-pill.outline {
        border: 1px solid var(--glass-border);
        color: var(--text-secondary);
    }

    .tag-pill.outline:hover {
        border-color: var(--accent-primary);
        color: var(--accent-primary);
    }

    .all-tags-link {
        margin-left: auto;
    }

    /* Empty state */
    .empty-state {
        padding: 4rem 2rem;
        text-align: center;
        border-radius: 1.5rem;
        margin-top: 2rem;
    }

    .empty-state p {
        color: var(--text-secondary);
        font-size: 1.1rem;
        margin-bottom: 1.5rem;
    }

    .clear-link {
        color: var(--accent-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .clear-link:hover {
        text-decoration: underline;
    }

    /* Post grid */
    .post-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
    }

    .post-card {
        padding: 2rem;
        border-radius: 2rem;
        display: flex;
        flex-direction: column;
    }

    .post-card[hidden] {
        display: none;
    }

    .date {
        font-size: 0.8rem;
        color: var(--accent-primary);
        font-weight: 600;
        margin-bottom: 1rem;
        font-family: var(--font-mono, monospace);
    }

    h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .post-card p {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .tags .tag {
        font-size: 0.75rem;
        padding: 0.2rem 0.6rem;
        background: var(--glass-border);
        border-radius: 99rem;
        color: var(--text-secondary);
        text-decoration: none;
        transition: all 0.2s;
    }

    .tags .tag:hover {
        background: var(--accent-primary);
        color: var(--bg-primary);
    }

    .read-more {
        font-weight: 600;
        color: var(--accent-primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .read-more:hover {
        text-decoration: underline;
    }
</style>
