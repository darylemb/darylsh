---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getAllProjects, slugifyProjectId } from "../lib/projects";

interface Props {
    /**
     * When true, render the section title as an <h1> (use on standalone pages).
     * When false (default), render as <h2> (use when embedded under another hero with h1).
     */
    standalone?: boolean;
    /**
     * When true, limit to featured projects only (used on the homepage).
     * Defaults to true — the homepage acts as a showcase, not a full index.
     */
    featuredOnly?: boolean;
}

const { standalone = false, featuredOnly = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const Tag = standalone ? "h1" : "h2";

const allProjects = await getAllProjects(lang);
const projects = featuredOnly
    ? allProjects.filter((p) => p.data.featured)
    : allProjects;
---

<section id="projects" class="container">
    <div class="header">
        <Tag>{t("projects.title")}</Tag>
        <p>{t("projects.description")}</p>
    </div>
    <div class="grid">
        {
            projects.map((project) => (
                <div class="project-card glass hover-lift">
                    <div class="tags">
                        {project.data.tags.map((tag) => (
                            <span class="tag">
                                {tag.icon && (
                                    <img
                                        src={tag.icon}
                                        alt={tag.name}
                                        width="16"
                                        height="16"
                                    />
                                )}
                                {tag.name}
                            </span>
                        ))}
                    </div>
                    <h3>{project.data.title}</h3>
                    <p>{project.data.description}</p>
                    <a
                        href={`/${lang}/projects/${slugifyProjectId(project)}`}
                        class="link"
                    >
                        {t("projects.view")} <span>→</span>
                    </a>
                </div>
            ))
        }
    </div>
    {
        !featuredOnly && projects.length === 0 && (
            <p class="empty">
                {lang === "es"
                    ? "Aún no hay proyectos publicados."
                    : "No projects published yet."}
            </p>
        )
    }
</section>

<style>
    #projects {
        padding: 100px 2rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .header {
        margin-bottom: 4rem;
    }

    h2 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .header p {
        color: var(--text-secondary);
        font-size: 1.1rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
    }

    .project-card {
        padding: 2rem;
        border-radius: 1.5rem;
        display: flex;
        flex-direction: column;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        border-radius: 99rem;
        background: var(--glass-border);
        color: var(--text-secondary);
    }

    .tag img {
        width: 14px;
        height: 14px;
        object-fit: contain;
    }

    h3 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .project-card p {
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .link {
        font-weight: 600;
        color: var(--accent-primary);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }

    .link:hover {
        text-decoration: underline;
    }

    .link span {
        transition: transform 0.2s;
    }

    .link:hover span {
        transform: translateX(4px);
    }

    .empty {
        text-align: center;
        color: var(--text-secondary);
        padding: 3rem 0;
    }
</style>
