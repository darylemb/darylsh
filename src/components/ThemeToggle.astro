---
// Toggle is a static UI element with a stable English label; no per-lang
// translation needed.
---

<button
    id="theme-toggle"
    class="theme-toggle"
    type="button"
    aria-label="Theme toggle"
    title="Theme toggle"
>
    <svg
        class="icon icon-sun"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <svg
        class="icon icon-moon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
    >
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
</button>

<script>
    import { getTheme, toggleTheme, getStoredTheme } from "../lib/theme";

    const btn = document.getElementById("theme-toggle");
    if (btn) {
        const update = (): void => {
            const theme = getTheme();
            btn.setAttribute("aria-pressed", theme === "light" ? "true" : "false");
        };

        btn.addEventListener("click", () => {
            toggleTheme();
            update();
        });

        // Keep toggle in sync if system preference changes AND user hasn't chosen
        const mediaQuery = window.matchMedia("(prefers-color-scheme: light)");
        mediaQuery.addEventListener("change", () => {
            if (getStoredTheme() === null) {
                document.documentElement.setAttribute(
                    "data-theme",
                    getTheme(),
                );
                update();
            }
        });

        update();
    }
</script>

<style>
    .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        background: transparent;
        border: 1px solid var(--glass-border);
        border-radius: 9999px;
        color: var(--text-secondary);
        cursor: pointer;
        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease;
    }

    .theme-toggle:hover {
        color: var(--text-primary);
        border-color: var(--accent-primary);
    }

    .theme-toggle:focus-visible {
        outline: 2px solid var(--accent-primary);
        outline-offset: 2px;
    }

    .icon {
        display: none;
    }

    /* Show moon when dark, sun when light. Default (no attribute) = dark. */
    :root[data-theme="dark"] .icon-moon,
    :root:not([data-theme]) .icon-moon {
        display: block;
    }
    :root[data-theme="light"] .icon-sun {
        display: block;
    }
</style>
